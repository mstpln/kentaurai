{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kentaurai-local",
  "main": "./src/worker-v079.js",
  "compatibility_date": "2026-09-06",
  "secrets": {
    "required": ["APP_PASSWORD", "ADMIN_TOKEN"]
  },
  "vars": {
    "ANALYSIS_WORKFLOW_MODE": "v3",
    "V85_LINE_PRICE_SEK": "0.50",
    "V86_LINE_PRICE_SEK": "0.25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kentaurai-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "kentaurai-local-raw",
      "remote": false
    }
  ]
}
